DATABASE_URL=postgresql://user:password@localhost:5432/crisisconnect
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of origins allowed by CORS (localhost dev ports are allowed automatically outside production)
FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
# Optional: image analysis of report photos. Without a key, photos are stored but not analyzed.
GEMINI_API_KEY=
# Optional: Gemini models are retired on a schedule; see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: `npm run seed:users` creates an admin account when this is set (also used by `npm test`)
SEED_ADMIN_PASSWORD=
# Optional: debug, info (default), warn, error
LOG_LEVEL=info
