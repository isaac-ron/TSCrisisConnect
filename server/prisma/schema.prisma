// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  role     String   @default("user") // admin, first-responder, user
  badgeId  String?  @unique
  reports  Report[]
  messages Message[]
}

model Report {
  id                Int      @id @default(autoincrement())
  description       String
  location          String?
  status            String   @default("pending")
  timestamp         DateTime @default(now())
  attachment        String?
  user              User     @relation(fields: [userId], references: [id])
  userId            Int

  // Fields for NLP processing
  source            String   @default("direct_report") // "direct_report" or "twitter"
  extractedLocation String?
  severity          String?  // e.g., "High", "Medium", "Low"
  crisisType        String?
  confidence        Float?
  latitude          Float?
  longitude         Float?
  isVerified        Boolean  @default(false)
  
  // First responder assignment
  assignedResponderId Int?
  assignedResponder   FirstResponder? @relation("ResponderToReport", fields: [assignedResponderId], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  type      String   @default("general") // general, alert
  timestamp DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  Int
  
  // NLP insights from ML service
  isCrisis       Boolean? @default(false)
  severity       String?  // "Low", "Medium", "High", "Critical"
  crisisType     String?  // extracted crisis category
  confidence     Float?   // ML model confidence score
  entities       String?  // JSON string of extracted entities (locations, people, etc)
  
  // First responder assignment
  assignedResponderId Int?
  assignedResponder   FirstResponder? @relation(fields: [assignedResponderId], references: [id])
}

model SocialAlert {
  id                Int      @id @default(autoincrement())
  description       String
  source            String // e.g., 'twitter', 'facebook'
  sourceUrl         String?
  timestamp         DateTime @default(now())
  isVerified        Boolean  @default(false)

  // NLP and Geocoding data
  crisisType        String?  // e.g., 'earthquake', 'fire', 'flood', etc.
  extractedLocation String?
  severity          String?
  latitude          Float?
  longitude         Float?
}

model FirstResponder {
  id          Int       @id @default(autoincrement())
  name        String
  badgeNumber String    @unique
  department  String    // "Fire", "Police", "Medical", "Emergency Management"
  phoneNumber String    // Direct contact number
  email       String?   @unique
  status      String    @default("available") // "available", "on-duty", "off-duty"
  createdAt   DateTime  @default(now())
  
  // Relations
  assignedMessages Message[]
  assignedReports  Report[] @relation("ResponderToReport")
}