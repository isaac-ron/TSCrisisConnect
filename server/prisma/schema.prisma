generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int        @id @default(autoincrement())
  name              String
  email             String     @unique
  password          String
  role              String     @default("user") // user, first-responder, admin
  badgeId           String?    @unique
  reports           Report[]
  reviewedIncidents Incident[] @relation("IncidentReviewer")
}

// One person's account of an emergency. Reports about the same event are grouped into an Incident.
model Report {
  id                Int       @id @default(autoincrement())
  description       String
  location          String?
  category          String?   // category chosen by the reporter, e.g. "fire", "medical"
  timestamp         DateTime  @default(now())
  attachment        String?
  user              User      @relation(fields: [userId], references: [id])
  userId            Int

  // NLP and image analysis
  isCrisis          Boolean?  // binary model verdict; null for reports created before it was stored
  crisisType        String?   // category key, see server/src/nlp/categories.js
  severity          String?   // Low, Medium, High, Critical
  confidence        Float?
  extractedLocation String?
  latitude          Float?
  longitude         Float?
  imageVerified     Boolean   @default(false) // attached photo independently classified as a crisis

  incident          Incident? @relation(fields: [incidentId], references: [id])
  incidentId        Int?

  @@index([incidentId])
}

enum ReviewStatus {
  pending   // not yet reviewed by a responder
  verified  // a responder confirmed it
  dismissed // a responder judged it false, duplicate or not an emergency
  resolved  // over
}

// Reports of the same crisis type, close in place and time. Corroboration (independent reporters,
// photo evidence, a matching official alert) is computed from its reports; review is by responders.
model Incident {
  id              Int            @id @default(autoincrement())
  crisisType      String
  priority        String         @default("Low") // highest severity among its reports
  latitude        Float?
  longitude       Float?
  locationName    String?
  firstReportedAt DateTime       @default(now())
  lastReportedAt  DateTime       @default(now())

  reviewStatus    ReviewStatus   @default(pending)
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedBy      User?          @relation("IncidentReviewer", fields: [reviewedById], references: [id])
  reviewedById    Int?

  officialAlert   ExternalAlert? @relation(fields: [officialAlertId], references: [id])
  officialAlertId Int?

  reports         Report[]

  @@index([crisisType, lastReportedAt])
}

// Events from official sources (USGS earthquakes, GDACS disaster alerts)
model ExternalAlert {
  id          Int        @id @default(autoincrement())
  source      String     // "usgs" or "gdacs"
  externalId  String
  title       String
  url         String?
  crisisType  String     // category key
  severity    String     // Low, Medium, High, Critical
  latitude    Float?
  longitude   Float?
  eventTime   DateTime
  fetchedAt   DateTime   @default(now())
  incidents   Incident[]

  @@unique([source, externalId])
  @@index([eventTime])
}
